# Bot-Token aus dem Developer Portal: https://discord.com/developers/applications
# dort: Application -> Bot -> "Reset Token". Niemals committen.
DISCORD_TOKEN=

# Server-ID: in Discord Einstellungen -> "Entwicklermodus" aktivieren,
# dann Server mit Rechtsklick -> "Server-ID kopieren".
DISCORD_GUILD_ID=

# Zeitzone, in der die Wochenuebersicht gerechnet wird.
TIMEZONE=Europe/Berlin

# 1 = Woche beginnt am Montag, 0 = Sonntag.
WEEK_STARTS_ON=1

# Anzeigehoehe einer Stunde in Pixeln.
HOUR_HEIGHT=46

# Spuren und Grundzeilen (Standard: lanes.json neben dem Server).
# LANES_FILE=lanes.json

# Fallback-Dauer fuer Events ohne Endzeit in Discord (Minuten).
DEFAULT_DURATION_MINUTES=120

# Wie lange die Discord-Antwort serverseitig gecacht wird (ms).
CACHE_TTL_MS=60000

# Lokaler Webserver.
HOST=127.0.0.1
PORT=3000
